// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CLIENT") // "CLIENT" | "ADMIN"
  phone     String?
  createdAt DateTime @default(now())

  requests  Request[]
  messages  Message[]
}

model Request {
  id          String   @id @default(cuid())
  siteName    String
  purpose     String
  phone       String
  contactName String
  status      String   @default("NEW") // "NEW" | "IN_PROGRESS" | "QUOTE_SENT" | "IN_DEVELOPMENT" | "COMPLETED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
}
